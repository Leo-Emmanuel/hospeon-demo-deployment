{
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "env": {
    "SKIP_ENV_VALIDATION": "true",
    "PRISMA_SKIP_POSTINSTALL_GENERATE": "1"
  }
}
