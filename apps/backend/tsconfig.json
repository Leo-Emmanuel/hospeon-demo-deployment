{
  "extends": "../../packages/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2020",
    "ignoreDeprecations": "5.0"
  },
  "include": ["src", "prisma"],
  "exclude": ["node_modules", "dist"]
}
