{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "pnpm --filter @hospeon/shared build && tsc",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "start": "prisma migrate deploy && node dist/server.js"
  },
  "dependencies": {
    "@hospeon/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^8.16.2",
    "pino-http": "^8.5.0",
    "prisma": "5.22.0",
    "socket.io": "^4.7.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@hospeon/tsconfig": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "pino-pretty": "^10.2.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
