{
  "buildCommand": "pnpm --filter=frontend run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "env": {
    "PNPM_HOME": ".pnpm",
    "SKIP_ENV_VALIDATION": "true",
    "PRISMA_SKIP_POSTINSTALL_GENERATE": "1"
  }
}
